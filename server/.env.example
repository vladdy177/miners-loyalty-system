PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=miners_loyalty
DB_USER=postgres
DB_PASSWORD=your_password

JWT_SECRET=your_jwt_secret_here

# Google Wallet service account key (JSON string or path to file)
# For local dev: path to the JSON file downloaded from Google Cloud Console
# For production: paste the entire JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173
